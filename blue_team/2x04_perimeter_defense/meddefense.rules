# 1. Med Device to Internet (TCP & UDP except NTP 123)
alert tcp 10.10.4.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE Med Device TCP to Internet"; classtype:policy-violation; sid:9000001; rev:1;)
alert udp 10.10.4.0/24 any -> !$HOME_NET !123 (msg:"MEDDEFENSE Med Device UDP to Internet"; classtype:policy-violation; sid:9000007; rev:1;)

# 2. Unauthorized SMB from Guest Network (10.10.5.0/24 -> $HOME_NET:445)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"MEDDEFENSE Unauthorized Guest SMB Traffic"; classtype:unauthorized-traffic; sid:9000002; rev:1;)

# 3. Large Outbound Traffic From Server (10.10.1.0/24 > 50MB in 300s)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE Large Outbound Data Transfer from Server"; threshold: type threshold, track by_src, count 1, seconds 300; filesize:>52428800; classtype:bad-unknown; sid:9000003; rev:1;)

# 4. DNS Tunneling Long Label (> 50 chars in DNS query)
alert dns any any -> any any (msg:"MEDDEFENSE DNS Tunneling Long Label Detected"; dns.query; pcre:"/[a-zA-Z0-9-]{51,}/"; classtype:bad-unknown; sid:9000004; rev:1;)

# 5. Clinical Workstation to Unauthorized Database (10.10.2.0/24 -> !AuthorizedDB:3306)
alert tcp 10.10.2.0/24 any -> ![10.10.1.50] 3306 (msg:"MEDDEFENSE Clinical Workstation to Unauthorized DB"; classtype:unauthorized-traffic; sid:9000005; rev:1;)

# 6. Telnet Cleartext to Medical Device (any -> 10.10.4.0/24:23)
alert tcp any any -> 10.10.4.0/24 23 (msg:"MEDDEFENSE Cleartext Telnet to Medical Device"; classtype:policy-violation; sid:9000006; rev:1;)
